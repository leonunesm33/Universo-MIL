# Database
DATABASE_URL="postgresql://unimil:changeme@db:5432/unimil?schema=public"
DB_PASSWORD="changeme"

# NextAuth — gere com: openssl rand -base64 32
AUTH_SECRET="GERE_COM_OPENSSL_RAND_BASE64_32"
AUTH_URL="http://localhost:3000"

# JWT para tokens de convite, magic-link e redefinição de senha
JWT_SECRET="GERE_COM_OPENSSL_RAND_BASE64_32"

# SMTP — em dev apontar para MailHog
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
